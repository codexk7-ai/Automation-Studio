# Automation Studio configuration. Copy to .env (or run `npm run setup`).
# Placeholder values only — never commit real secrets.

# Brand shown in the UI and MCP server name.
BRAND_NAME=Automation Studio

# 32-byte key (64 hex chars) for AES-256-GCM credential encryption. REQUIRED.
# `npm run setup` generates one. Losing it makes stored connections unreadable.
ENCRYPTION_KEY=

HOST=127.0.0.1
PORT=8787
# Public base URL (webhook links, OAuth redirect URIs, MCP endpoint).
PUBLIC_URL=http://localhost:8787

# Database: leave empty for the embedded PostgreSQL (PGlite, stored in apps/server/.data).
# For production / multiple workers use a real PostgreSQL server:
# DATABASE_URL=postgres://automation:change-me@localhost:5432/automation
DATABASE_URL=
PGLITE_DATA_DIR=

# Worker: "embedded" runs it inside the API process; "off" requires `npm run worker` (PostgreSQL only).
WORKER_MODE=embedded
WORKER_CONCURRENCY=4

# Security
ALLOW_REGISTRATION=true
SECURE_COOKIES=false
SESSION_TTL_HOURS=168
AUTH_RATE_LIMIT_PER_MINUTE=10
# Set to true only behind a trusted reverse proxy.
TRUST_PROXY=false
# host:port pairs exempt from private-network blocking (default: local Ollama).
OUTBOUND_ALLOWLIST=localhost:11434,127.0.0.1:11434
# Extra origins allowed to call /mcp from a browser (comma separated).
CORS_ORIGINS=

# Optional: server-wide SMTP. Without it, emails are captured in the local outbox (not delivered).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM=Automation Studio <no-reply@localhost>

# Optional: Google OAuth client (Sheets, YouTube). Redirect URI: <PUBLIC_URL>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LOG_LEVEL=info
