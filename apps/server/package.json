{
  "name": "@automation-studio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automation Studio control plane (API), execution workers, integrations, AI and MCP.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "build": "node scripts/build.mjs",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "mcp:stdio": "tsx src/cli/mcp-stdio.ts",
    "typecheck": "tsc -p tsconfig.json",
    "migrate:prod": "node dist/migrate.js",
    "rotate-key": "tsx src/cli/rotate-key.ts",
    "rotate-key:prod": "node dist/rotate-key.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@automation-studio/core": "0.1.0",
    "@electric-sql/pglite": "^0.5.11",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@vercel/functions": "^3.10.3",
    "ajv": "^8.20.0",
    "croner": "^10.0.1",
    "fastify": "^5.12.7",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.2.1",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.14",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.15.6",
    "@types/smtp-server": "^3.5.13",
    "esbuild": "^0.28.2",
    "mailparser": "^3.12.4",
    "smtp-server": "^3.21.1",
    "tsx": "^4.23.15"
  }
}
