# Automation Studio configuration. Copy to .env (or run `npm run setup`).
# Placeholder values only — never commit real secrets.

# Brand shown in the UI and MCP server name.
BRAND_NAME=Automation Studio

# 32-byte key (64 hex chars) for AES-256-GCM credential encryption. REQUIRED.
# `npm run setup` generates one. Losing it makes stored connections unreadable.
ENCRYPTION_KEY=

HOST=127.0.0.1
PORT=8787
# Public base URL (webhook links, OAuth redirect URIs, MCP endpoint).
PUBLIC_URL=http://localhost:8787

# Database: leave empty for the embedded PostgreSQL (PGlite, stored in apps/server/.data).
# For production / multiple workers use a real PostgreSQL server:
# DATABASE_URL=postgres://automation:change-me@localhost:5432/automation
DATABASE_URL=
PGLITE_DATA_DIR=

# Worker: "embedded" runs it inside the API process; "off" requires `npm run worker` (PostgreSQL only).
WORKER_MODE=embedded
WORKER_CONCURRENCY=4

# Security
ALLOW_REGISTRATION=true
SECURE_COOKIES=false
SESSION_TTL_HOURS=168
AUTH_RATE_LIMIT_PER_MINUTE=10
# Set to true only behind a trusted reverse proxy.
TRUST_PROXY=false
# host:port pairs exempt from private-network blocking (default: local Ollama).
OUTBOUND_ALLOWLIST=localhost:11434,127.0.0.1:11434
# Extra origins allowed to call /mcp from a browser (comma separated).
CORS_ORIGINS=

# Optional: server-wide SMTP. Without it, emails are captured in the local outbox (not delivered).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM=Automation Studio <no-reply@localhost>

# Optional: Google OAuth client (Sheets, YouTube). Redirect URI: <PUBLIC_URL>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: single sign-on with any OpenID Connect provider (Google Workspace, Microsoft Entra ID,
# Okta, Keycloak, Authentik…). Redirect URI: <PUBLIC_URL>/api/auth/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated email domains allowed to sign in (empty = any verified email).
OIDC_ALLOWED_DOMAINS=
# Create an account (with its own workspace) for unknown SSO users; otherwise an admin adds them first.
OIDC_AUTO_CREATE_USERS=false
OIDC_BUTTON_LABEL=Sign in with SSO

# Maximum video size for the YouTube upload step (downloaded into memory).
YOUTUBE_MAX_UPLOAD_MB=512

# Production: bearer token for Prometheus scraping of /metrics (unset = /metrics disabled).
METRICS_TOKEN=
# Production refuses to start with unsafe settings; true downgrades those errors to warnings (staging only).
ALLOW_UNSAFE_PRODUCTION_CONFIG=false

# Vercel only (see docs/VERCEL.md): secret for /api/internal/tick (Vercel Cron + GitHub Action).
CRON_SECRET=
# Optional tuning: background drain after a request, and per-tick budget (milliseconds).
DRAIN_BUDGET_MS=25000
TICK_BUDGET_MS=45000
# PostgreSQL pool size per instance (default 10; 3 on Vercel).
DATABASE_POOL_SIZE=

# docker-compose production stack only (see docs/DEPLOYMENT.md)
DOMAIN=
POSTGRES_PASSWORD=
ACME_EMAIL=
BACKUP_KEEP_DAYS=14

LOG_LEVEL=info
